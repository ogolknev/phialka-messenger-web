    "imask": "^7.6.1",
    "inputmask": "^5.0.9",
    "lodash": "^4.17.21",
    "openapi-fetch": "^0.15.0",
    "overlayscrollbars": "^2.13.0",
    "pinia": "^3.0.4",
    "tailwindcss": "^4.1.18",
    "vue": "^3.5.26",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@tsconfig/node22": "^22.0.5",
    "@types/inputmask": "^5.0.7",
    "@types/jsdom": "^27.0.0",
